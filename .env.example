# ---------------------------------------------------------------------------
# MSDEV — environment
# Copy to `.env.local` for development, and set the same keys on your host.
# ---------------------------------------------------------------------------

# Canonical origin. Used for metadata, Open Graph, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://msdev.dz

# Where contact form submissions are delivered.
#
# ⚠ REQUIRED IN PRODUCTION. Without it the API route accepts the submission and
#   logs it to the server console, but nothing reaches you — you would lose
#   every lead. Point it at anything that accepts a JSON POST:
#     · a Slack or Discord incoming webhook
#     · a Make / Zapier / n8n hook
#     · a Supabase edge function that writes to a table and emails you
#     · your own mailer endpoint
#
# CONTACT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
